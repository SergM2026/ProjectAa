# ============================================================
#  Insurance Lead Pipeline — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# ── Apollo.io ────────────────────────────────────────────────
# Get from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_PAGE_SIZE=25
APOLLO_MAX_PAGES=20

# ── ZeroBounce ───────────────────────────────────────────────
# Get from: https://www.zerobounce.net/members/apikey
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# ── HubSpot ──────────────────────────────────────────────────
# Create a Private App: HubSpot > Settings > Integrations > Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxx

# ── Instantly.ai ─────────────────────────────────────────────
# Get from: https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=your_instantly_api_key_here
# Campaign ID from the URL: app.instantly.ai/app/campaign/<campaign_id>/settings
INSTANTLY_CAMPAIGN_ID=your_campaign_id_here

# ── Expandi.io ───────────────────────────────────────────────
# Get from: https://app.expandi.io/settings/api
EXPANDI_API_KEY=your_expandi_api_key_here
# Campaign ID from your Expandi dashboard
EXPANDI_CAMPAIGN_ID=your_expandi_campaign_id_here

# ── Calendly ─────────────────────────────────────────────────
# Get from: https://calendly.com/integrations/api_webhooks
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_signing_key_here

# ── Slack ────────────────────────────────────────────────────
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=REPLACE_WITH_YOUR_SLACK_INCOMING_WEBHOOK_URL
SLACK_CHANNEL=#insurance-leads

# ── Webhook Server ───────────────────────────────────────────
# Random secret used to verify Instantly.ai webhook signatures
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_signing_secret_here
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ── Pipeline Behaviour ───────────────────────────────────────
# Set to true to run without touching any outreach/CRM APIs (safe for testing)
DRY_RUN=false
TARGET_STATE=Utah
