{
  "name": "Lead Ingestion Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1,3,5"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger (Mon/Wed/Fri 7am)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/pipeline/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "dry_run", "value": "false" }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "run-pipeline",
      "name": "Run Python Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300],
      "notes": "Calls the FastAPI server which triggers apollo_client → enrichment → crm_sync → outreach"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "channel": "#insurance-leads",
        "text": "✅ Lead pipeline run FAILED. Check logs at {{ $json.error }}",
        "otherOptions": {}
      },
      "id": "slack-error",
      "name": "Slack Error Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [900, 440],
      "credentials": { "slackApi": { "id": "slack-creds", "name": "Slack" } }
    }
  ],
  "connections": {
    "Schedule Trigger (Mon/Wed/Fri 7am)": {
      "main": [[{ "node": "Run Python Pipeline", "type": "main", "index": 0 }]]
    },
    "Run Python Pipeline": {
      "main": [[{ "node": "Check Success", "type": "main", "index": 0 }]]
    },
    "Check Success": {
      "main": [
        [],
        [{ "node": "Slack Error Alert", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "_meta": {
    "instanceId": "lead-pipeline-n8n"
  }
}
